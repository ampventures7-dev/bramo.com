# ==============================================================================
# bhramo.com — Environment Variables Configuration Template
# For production deployment on Vercel, copy these to your Vercel Project Settings:
# Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Exposed to Browser via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------

# Official Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Official Supabase Public Anonymous API Key (Safe for browser - respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Production Base URL
NEXT_PUBLIC_SITE_URL=https://bhramo.com

# Default WhatsApp Support / Konkan Desk Helpline (+91 country code without + or spaces)
NEXT_PUBLIC_DEFAULT_WHATSAPP_PHONE=919876543210

# Toggle Fast Demo Logins in Production/Staging (set to "false" in strict production, "true" for teammate review previews)
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# ------------------------------------------------------------------------------
# 2. FIREBASE PHONE AUTH (10,000 Free SMS OTPs / Month in India)
# Get from Firebase Console -> Project Settings -> General -> Your apps (Web)
# Enable Phone provider in Firebase Authentication -> Sign-in method
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE ONLY VARIABLES (NEVER prefixed with NEXT_PUBLIC_ - Secure)
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Used strictly in server routes e.g. /api/health and admin tasks)
# WARNING: NEVER expose this key in client components or with NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Health Check Cron Secret (To authenticate automated ping requests to /api/health)
HEALTH_CRON_SECRET=your-random-cron-secret-token

# Google Gemini API Key (For AI Trip Planner - Dapoli & Harnai coastal itineraries)
# Get a 100% free API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If omitted, bhramo.com automatically falls back to its built-in local Konkan Travel Engine.
GEMINI_API_KEY=your-gemini-api-key

